# ============================================================
# JARVIS 2.0 - Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ---------------------------------------------------------------- General
ASSISTANT_NAME=JARVIS
USER_NAME=Sir
LANGUAGE=en
RESPONSE_STYLE=balanced
DEBUG=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
DATA_DIR=data
DB_PATH=data/jarvis.db
LOGS_DIR=logs

# ---------------------------------------------------------------- Groq (Default AI Provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1024
GROQ_STREAMING=true

# ---------------------------------------------------------------- Gemini (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------- OpenRouter (Optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ---------------------------------------------------------------- Local LLM (Optional)
LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_API_TYPE=openai
LOCAL_LLM_TIMEOUT=60

# ---------------------------------------------------------------- AI Router
AI_PROVIDER=auto
AUTO_FAILOVER=true
PROVIDER_PRIORITY=groq_first

# ---------------------------------------------------------------- Voice / TTS
VOICE_ENABLED=true
VOICE_LANGUAGE=en-US
MIC_DEVICE=
STT_ENGINE=google
VOSK_MODEL_PATH=
WAKE_WORD_ENABLED=false
WAKE_WORD=Hey JARVIS
PUSH_TO_TALK=false
CONTINUOUS_LISTENING=false
VAD_ENABLED=false

# Kokoro TTS
TTS_ENGINE=kokoro
TTS_VOICE=
TTS_SPEED=150
TTS_VOLUME=80
TTS_ENABLED=true
KOKORO_MODEL_PATH=
KOKORO_VOICE=
# Dedicated virtualenv holding kokoro + torch (Python 3.11/3.12 only).
# The main interpreter (Python 3.14) cannot install kokoro, so JARVIS runs a
# persistent worker subprocess using this interpreter. Auto-detects tts-venv/.
TTS_VENV_DIR=

# ---------------------------------------------------------------- Memory
MEMORY_ENABLED=true
VECTOR_MEMORY_ENABLED=false

# ---------------------------------------------------------------- Web Search
WEB_SEARCH_API_KEY=

# ---------------------------------------------------------------- Appearance
THEME=dark
ACCENT_COLOR=cyan
GLOW_INTENSITY=50
ANIMATION_LEVEL=full
ORB_SIZE=64
COMPACT_UI=false
PANEL_TRANSPARENCY=85
BACKGROUND_PARTICLES=true

# ---------------------------------------------------------------- Tools
TERMINAL_CONFIRM_DANGEROUS=true
FILESYSTEM_PROTECTED_DIRS=/etc,/bin,/usr/bin,/sbin,/sys,/proc,/dev

# ---------------------------------------------------------------- UI Presets
UI_PRESET=jarvis

# ---------------------------------------------------------------- Notifications
NOTIFICATIONS_ENABLED=true
LINUX_DESKTOP_NOTIFICATIONS=true

# ---------------------------------------------------------------- Image Generation
IMAGE_GENERATION_ENABLED=true
IMAGE_PROVIDER=auto
PIXAZO_API_KEY=
PUTER_API_KEY=

# ---------------------------------------------------------------- Video Generation
VIDEO_GENERATION_ENABLED=true
VIDEO_PROVIDER=auto
FAL_API_KEY=
MAGIC_HOUR_API_KEY=

# ---------------------------------------------------------------- Gesture Control
GESTURE_CONTROL_ENABLED=false
GESTURE_CAMERA_DEVICE=
GESTURE_SENSITIVITY=50

# ---------------------------------------------------------------- Call Control
CALL_CONTROL_ENABLED=false
CALL_PROVIDER=
CALL_API_KEY=
CALL_ASSIST_MODE=notify_only
